# Chạy được ngay khi chưa có database.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Backend: transaction pooler 6543 hoặc session pooler 5432.
# Không đặt sslmode/sslrootcert/sslcert/sslkey trong URL; dùng DB_SSL bên dưới.
DATABASE_URL=
# Migration: session pooler 5432 hoặc direct endpoint; không dùng cổng 6543.
DIRECT_URL=
DB_SSL=verify-full
# Nếu cần CA riêng, tải từ dashboard nhà cung cấp và điền đường dẫn file.
DB_SSL_CA_PATH=
DB_POOL_MAX=5
DB_TIMEOUT_MS=3000

# URL public của project; không cần JWT secret/service_role key cho backend.
# Dùng signing key ES256/RS256. JWT HS256 cũ phải refresh sau khi đổi signing key.
SUPABASE_URL=https://your-project-ref.supabase.co
AUTH_TIMEOUT_MS=5000
# Dung sai đồng hồ JWT, 0..120 giây; mặc định 5. Máy lệch ~1 phút có thể dùng 60.
AUTH_CLOCK_TOLERANCE_SECONDS=5
# Chỉ cần cho Mobile hoặc npm.cmd run auth:live, không dùng làm user access token.
SUPABASE_PUBLISHABLE_KEY=
# npm.cmd run db:runtime tạo login hạn chế quyền và cập nhật DATABASE_URL cục bộ.
# DIRECT_URL luôn giữ tài khoản quản trị cho migration.

# Chỉ dùng DB_SSL=disable khi PostgreSQL local không bật TLS.
# DATABASE_URL=postgresql://postgres:local_password@127.0.0.1:5432/streeteye

# Public catalog served by this process: demo or pilot
DATA_MODE=demo
MAPILLARY_ACCESS_TOKEN=
